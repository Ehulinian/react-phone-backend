# Stripe test-mode secret key (never commit the real value).
# Get one from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Comma-separated list of origins allowed to call this API.
# Include your local dev server and your deployed GitHub Pages URL.
ALLOWED_ORIGINS=http://localhost:3000,https://your-username.github.io

# Fallback frontend origin used to build Stripe redirect URLs if the
# frontend doesn't send its own origin in the request body.
FRONTEND_URL=https://your-username.github.io/react_phone-catalog

PORT=4000
